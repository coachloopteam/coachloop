# Supabase (new project, separate from AvalonLabs) — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (used for per-log AI feedback, lib/ai.ts)
ANTHROPIC_API_KEY=

# Paddle — existing merchant account, NEW Product/price created in that catalog.
# The 6 tier price IDs (Starter/Pro/Advanced x month/year) live in lib/pricing-tiers.ts,
# not here — see that file to swap in production IDs later.
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
# Server-side secret key — Developer tools > Authentication > API keys.
# Different from PADDLE_WEBHOOK_SECRET above. Needed for the customer portal
# (lib/paddle/portal.ts); webhook signature verification does not use it.
PADDLE_API_KEY=
